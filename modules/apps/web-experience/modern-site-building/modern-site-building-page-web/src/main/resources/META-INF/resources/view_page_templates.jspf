<liferay-frontend:management-bar
	disabled="false"
	includeCheckBox="true"
	searchContainerId="msbPageTemplates"
>
	<liferay-frontend:management-bar-buttons>
		<liferay-frontend:management-bar-display-buttons
			displayViews='<%= new String[] {"icon"} %>'
			portletURL="<%= currentURLObj %>"
			selectedDisplayStyle="<%= msbPageTemplateDisplayContext.getDisplayStyle() %>"
		/>
	</liferay-frontend:management-bar-buttons>

	<liferay-frontend:management-bar-filters>
		<liferay-frontend:management-bar-navigation
			navigationKeys='<%= new String[] {"all"} %>'
			portletURL="<%= currentURLObj %>"
		/>

		<liferay-frontend:management-bar-sort
			orderByCol="<%= msbPageTemplateDisplayContext.getOrderByCol() %>"
			orderByType="<%= msbPageTemplateDisplayContext.getOrderByType() %>"
			orderColumns="<%= msbPageTemplateDisplayContext.getOrderColumns() %>"
			portletURL="<%= currentURLObj %>"
		/>
	</liferay-frontend:management-bar-filters>

	<liferay-frontend:management-bar-action-buttons>
		<liferay-frontend:management-bar-button href="javascript:;" icon="trash" id="deleteSelectedMSBPageTemplates" label="delete" />
	</liferay-frontend:management-bar-action-buttons>
</liferay-frontend:management-bar>

<portlet:actionURL name="/page_template/delete_template" var="deleteMSBPageTemplateURL">
	<portlet:param name="redirect" value="<%= currentURL %>" />
</portlet:actionURL>

<aui:form action="<%= deleteMSBPageTemplateURL %>" cssClass="container-fluid-1280" name="fm">
	<div class="breadcrumb" id="<portlet:namespace />breadcrumbContainer">
		<liferay-util:include page="/breadcrumb.jsp" servletContext="<%= application %>" />
	</div>

	<liferay-ui:search-container
		emptyResultsMessage="no-page-template-was-found"
		id="msbPageTemplates"
		searchContainer="<%= msbPageTemplateDisplayContext.getSearchContainer() %>"
	>
		<liferay-ui:search-container-row
			className="Object"
			cssClass="entry-display-style"
			modelVar="object"
		>

			<%
			MSBPageTemplate msbPageTemplate = null;
			MSBPageTemplateFolder msbPageTemplateFolder = null;

			Object result = row.getObject();

			if (result instanceof MSBPageTemplate) {
				msbPageTemplate = (MSBPageTemplate)result;
			}
			else {
				msbPageTemplateFolder = (MSBPageTemplateFolder)result;
			}
			%>

			<c:choose>
				<c:when test="<%= msbPageTemplateFolder != null %>">

					<%
					row.setCssClass("entry-card lfr-asset-folder " + row.getCssClass());
					%>

					<portlet:renderURL var="rowURL">
						<portlet:param name="mvcPath" value="/view.jsp" />
						<portlet:param name="toolbarItem" value="view-page-templates" />
						<portlet:param name="msbPageTemplateFolderId" value="<%= String.valueOf(msbPageTemplateFolder.getMsbPageTemplateFolderId()) %>" />
					</portlet:renderURL>

					<liferay-ui:search-container-column-text>
						<liferay-frontend:icon-vertical-card
							actionJsp="/page_template_folder_action.jsp"
							actionJspServletContext="<%= application %>"
							icon="folder"
							resultRow="<%= row %>"
							rowChecker="<%= searchContainer.getRowChecker() %>"
							title="<%= msbPageTemplateFolder.getName() %>"
							url="<%= rowURL.toString() %>"
						>
							<liferay-frontend:vertical-card-header>
								<liferay-ui:message arguments="<%= LanguageUtil.getTimeDescription(request, System.currentTimeMillis() - msbPageTemplateFolder.getCreateDate().getTime(), true) %>" key="x-ago" translateArguments="<%= false %>" />
							</liferay-frontend:vertical-card-header>
						</liferay-frontend:icon-vertical-card>
					</liferay-ui:search-container-column-text>
				</c:when>
				<c:otherwise>

					<%
					row.setCssClass("entry-card" + row.getCssClass());
					%>

					<liferay-ui:search-container-column-text>
						<liferay-frontend:icon-vertical-card
							actionJsp="/page_template_action.jsp"
							actionJspServletContext="<%= application %>"
							icon="page"
							resultRow="<%= row %>"
							rowChecker="<%= searchContainer.getRowChecker() %>"
							title="<%= msbPageTemplate.getName() %>"
						>
							<liferay-frontend:vertical-card-header>
								<liferay-ui:message arguments="<%= LanguageUtil.getTimeDescription(request, System.currentTimeMillis() - msbPageTemplate.getCreateDate().getTime(), true) %>" key="x-ago" translateArguments="<%= false %>" />
							</liferay-frontend:vertical-card-header>
						</liferay-frontend:icon-vertical-card>
					</liferay-ui:search-container-column-text>
				</c:otherwise>
			</c:choose>
		</liferay-ui:search-container-row>

		<liferay-ui:search-iterator displayStyle="<%= msbPageTemplateDisplayContext.getDisplayStyle() %>" markupView="lexicon" searchContainer="<%= msbPageTemplateDisplayContext.getSearchContainer() %>" />
	</liferay-ui:search-container>
</aui:form>

<liferay-frontend:add-menu>
	<c:choose>
		<c:when test="<%= msbPageTemplateDisplayContext.getMSBPageTemplateFolderId() > 0 %>">
			<liferay-portlet:renderURL var="addMSBPageTemplateURL" portletName="<%= PagesPortletKeys.PAGE_TEMPLATES %>">
				<liferay-portlet:param name="mvcPath" value="/edit_page_template.jsp" />
				<liferay-portlet:param name="redirect" value="<%= currentURL %>" />
				<liferay-portlet:param name="groupId" value="<%= String.valueOf(scopeGroupId) %>" />
			</liferay-portlet:renderURL>

			<liferay-frontend:add-menu-item title='<%= LanguageUtil.get(request, "page-template") %>' type="<%= AddMenuKeys.AddMenuType.PRIMARY %>" url="<%= addMSBPageTemplateURL.toString() %>" />
		</c:when>
		<c:otherwise>
			<liferay-portlet:renderURL var="addFolderURL" portletName="<%= PagesPortletKeys.PAGE_TEMPLATES %>">
				<liferay-portlet:param name="mvcPath" value="/edit_folder.jsp" />
				<liferay-portlet:param name="redirect" value="<%= currentURL %>" />
				<liferay-portlet:param name="groupId" value="<%= String.valueOf(scopeGroupId) %>" />
			</liferay-portlet:renderURL>

			<liferay-frontend:add-menu-item title='<%= LanguageUtil.get(request, "folder") %>' type="<%= AddMenuKeys.AddMenuType.PRIMARY %>" url="<%= addFolderURL.toString() %>" />
		</c:otherwise>
	</c:choose>
</liferay-frontend:add-menu>